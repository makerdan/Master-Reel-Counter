{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-supervisor.mjs",
    "build": "tsx script/build.ts",
    "release:build": "bash scripts/build-and-verify-release.sh",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.playwright.json --noEmit",
    "db:push": "drizzle-kit push",
    "lint:storage": "node scripts/lint-storage.mjs --strict",
    "test:unit": "node --import tsx/esm --test server/__tests__/routes.test.ts server/__tests__/photo-delete.test.ts server/__tests__/support-ops.test.ts scripts/__tests__/dev-supervisor.test.mjs",
    "test:vite-hmr": "node --import tsx/esm --test server/__tests__/vite.test.ts",
    "test:workspace-skill": "node --test scripts/workspace-skill-sync.test.mjs",
    "workspace-skill:refresh": "node scripts/workspace-skill-sync.mjs refresh",
    "workspace-skill:validate": "node scripts/workspace-skill-sync.mjs validate",
    "workspace-skill:audit": "node scripts/workspace-skill-sync.mjs audit",
    "workspace-skill:load": "node scripts/workspace-skill-sync.mjs load",
    "workspace-skill:status": "node scripts/workspace-skill-sync.mjs status",
    "test:e2e": "node scripts/serial-lock.mjs --resource e2e-port --priority 3 --timeout-ms 900000 -- npx playwright test",
    "verify:managed-clerk-release": "node scripts/serial-lock.mjs --resource managed-clerk-release --priority 3 --timeout-ms 900000 -- npx playwright test --config playwright.release.config.ts",
    "test:managed-clerk-release-contract": "node --test scripts/__tests__/managed-clerk-release.test.mjs && node --import tsx/esm --test scripts/__tests__/secret-safe-actions.test.ts scripts/__tests__/clerk-candidate-testing.test.ts",
    "test-fast": "node scripts/run-tier.mjs test-fast",
    "test-standard": "node scripts/run-tier.mjs test-standard",
    "test-standard-plus": "node scripts/run-tier.mjs test-standard-plus",
    "test-heavy": "node scripts/run-tier.mjs test-heavy",
    "ci": "npm run test-heavy",
    "test-light": "node scripts/run-tier.mjs test-light --allow-no-plan",
    "new-plan": "node scripts/new-plan.mjs",
    "check-failure-gate": "node scripts/check-failure-gate.mjs",
    "check-regression-guard": "node scripts/check-regression-guard.mjs",
    "run-locked-tier": "node scripts/run-locked-tier.mjs",
    "check-baseline": "node scripts/check-baseline.mjs",
    "maintain:validation-baseline": "node scripts/maintain-validation-baseline.mjs",
    "publish:failure-gate": "node scripts/publish-failure-gate.mjs",
    "verify:failure-gate": "npm run check-baseline && npm run publish:failure-gate && npm run check-failure-gate-parity",
    "check-failure-gate-parity": "node scripts/check-failure-gate-parity.mjs",
    "test:failure-gate": "node --test scripts/__tests__/failure-gate.test.mjs"
  },
  "dependencies": {
