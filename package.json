    "framer-motion": "^11.13.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.7",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.453.0",
    "memorystore": "^1.6.7",
    "multer": "^2.2.0",
    "next-themes": "^0.4.6",
    "openai": "^6.18.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
