{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-supervisor.mjs",
    "build": "tsx script/build.ts",
    "release:build": "bash scripts/build-and-verify-release.sh",
    "verify:managed-clerk-published": "npm run typecheck && node scripts/verify-published-release.mjs",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "check:playwright-configs": "node scripts/check-playwright-config-coverage.mjs && node --test scripts/__tests__/playwright-config-coverage.test.mjs",
    "check:port-references": "node scripts/port-reference-scan.mjs",
    "typecheck": "npm run check:playwright-configs && tsc --noEmit && tsc --project tsconfig.tests.json --noEmit && tsc --project tsconfig.playwright.json --noEmit",
    "db:push": "drizzle-kit push",
    "lint:storage": "node scripts/lint-storage.mjs --strict",
    "test:storage-lint-contract": "node --test scripts/__tests__/lint-storage.test.mjs",
    "test:unit": "node --import tsx/esm --test scripts/__tests__/dependency-tooling-security.test.mjs server/__tests__/dependency-media-security.test.ts server/__tests__/dependency-network-security.test.ts server/__tests__/routes.test.ts server/__tests__/help-chat-bounds.test.ts server/__tests__/pdf-authorization.test.ts server/__tests__/photo-delete.test.ts server/__tests__/support-ops.test.ts server/__tests__/poe-provider.test.ts server/__tests__/ai-provider-safety.test.ts server/__tests__/integrity-release-schema.test.ts server/__tests__/activity-statistics.test.ts scripts/__tests__/dev-supervisor.test.mjs scripts/__tests__/playwright-config-coverage.test.mjs scripts/__tests__/browser-validation-lifecycle.test.mjs scripts/__tests__/port-reference-scan.test.mjs",
    "test:vite-hmr": "node --import tsx/esm --test server/__tests__/vite.test.ts",
    "test:vite-hmr-recovery": "VITE_HMR_RECOVERY=1 npm run test:vite-hmr",
    "test:workspace-skill": "node --test scripts/workspace-skill-sync.test.mjs",
    "test:validation-reentrancy": "node scripts/ci-collision-test.mjs --non-smoke",
    "workspace-skill:refresh": "node scripts/workspace-skill-sync.mjs refresh",
    "workspace-skill:validate": "node scripts/workspace-skill-sync.mjs validate",
    "workspace-skill:audit": "node scripts/workspace-skill-sync.mjs audit",
    "workspace-skill:load": "node scripts/workspace-skill-sync.mjs load",
    "workspace-skill:status": "node scripts/workspace-skill-sync.mjs status",
    "test:e2e": "node scripts/serial-lock.mjs --resource e2e-port --priority 3 --timeout-ms 900000 -- node scripts/run-typechecked-playwright.mjs",
    "verify:managed-clerk-release": "node scripts/serial-lock.mjs --resource managed-clerk-release --priority 3 --timeout-ms 900000 -- node scripts/run-typechecked-playwright.mjs --config playwright.release.config.ts",
    "test:managed-clerk-release-contract": "node --test scripts/__tests__/managed-clerk-release.test.mjs scripts/__tests__/release-schema-preflight.test.mjs && node --import tsx/esm --test scripts/__tests__/secret-safe-actions.test.ts scripts/__tests__/clerk-candidate-testing.test.ts scripts/__tests__/clerk-bootstrap.test.ts",
    "test:clerk-preview-bootstrap": "node scripts/run-typechecked-playwright.mjs --config playwright.clerk-preview.config.ts",
    "test-fast": "node scripts/run-tier.mjs test-fast --allow-no-plan",
    "test-standard": "node scripts/run-tier.mjs test-standard --allow-no-plan",
    "test-standard-plus": "node scripts/run-tier.mjs test-standard-plus --allow-no-plan",
    "test-heavy": "node scripts/run-tier.mjs test-heavy --allow-no-plan",
    "ci": "npm run test-heavy",
    "check-baseline": "node scripts/check-baseline.mjs",
    "gate:new": "node scripts/unified-gate.mjs new",
    "gate:draft": "node scripts/unified-gate.mjs draft",
    "gate:guard": "node scripts/unified-gate.mjs guard",
    "gate:amend": "node scripts/unified-gate.mjs amend",
    "gate:restore-plan": "node scripts/unified-gate.mjs restore-plan",
    "gate:cancel": "node scripts/unified-gate.mjs cancel",
    "gate:run": "node scripts/unified-gate.mjs run",
    "gate:history": "node scripts/unified-gate.mjs history",
    "gate:classify": "node scripts/unified-gate.mjs classify",
    "gate:merge-guard": "node scripts/unified-gate.mjs merge-guard",
    "gate:status": "node scripts/unified-gate.mjs status",
    "gate:baseline-warnings": "node scripts/unified-gate.mjs baseline-warnings",
    "maintain:validation-baseline": "node scripts/maintain-validation-baseline.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "@clerk/express": "^2.1.67",
    "@clerk/react": "^6.15.2",
    "@clerk/shared": "^4.31.1",
    "@clerk/themes": "^2.4.57",
